# Copy to .env on the server and fill in. Never commit the real .env.

# The Supabase project.
SUPABASE_URL=https://zsplxgvizlndnofsokxw.supabase.co
# Public key (the same one the admin site and the app use).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET key (Supabase dashboard > Project settings > API keys > Secret keys).
# It bypasses every database rule, so it lives only here.
SUPABASE_SECRET_KEY=sb_secret_...

# Payments (optional; leave empty until you sell premium).
# Paystack dashboard > Settings > API Keys & Webhooks > Secret Key.
# Use the TEST key (sk_test_...) while trying things out.
PAYSTACK_SECRET_KEY=
# This server's public address, e.g.
# https://jarvis-norys.austriaeast.cloudapp.azure.com/brainwake
PUBLIC_URL=
